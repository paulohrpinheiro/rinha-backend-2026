# Stage 1: Build
FROM golang:1.26.3-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 go build \
    -ldflags="-s -w" \
    -trimpath \
    -o /proxy \
    ./cmd/proxy

# Stage 2: Runtime
FROM scratch
COPY --from=builder /proxy /proxy
EXPOSE 9999
ENTRYPOINT ["/proxy"]